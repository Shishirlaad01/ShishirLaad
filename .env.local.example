# Auto-populated by the Vercel + Upstash integration once you create the
# Redis database in the Vercel dashboard — you shouldn't need to set these by
# hand in production. Copy this file to .env.local only if testing api/*.js
# locally with `vercel dev`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# You choose this value yourself and set it in Vercel project env vars.
# It gates GET /api/stats — anyone with this token can read your traffic
# counts, so treat it like a password.
STATS_TOKEN=

# Stripe Payment Link for the Delivery Cockpit card (public URL, safe to expose
# to the browser — that's why it has the VITE_ prefix). Never put a Stripe
# secret key (sk_...) in a VITE_ variable: Vite bundles those into the page.
VITE_COCKPIT_PAY_URL=

# Used only by api/download.js to verify a Checkout Session is paid before
# serving the kit. NO VITE_ prefix — this must never reach the browser.
# Use sk_test_... locally / on preview, sk_live_... in Vercel production.
STRIPE_SECRET_KEY=
# Optional but recommended if the Stripe account sells anything else: the
# Payment Link id (plink_...) from Stripe → Payment Links → the link's URL.
STRIPE_PAYMENT_LINK_ID=

# LOCAL DEV ONLY: serve the kit zip straight from disk instead of Redis, so
# `npm run dev` can complete a test purchase with no Upstash setup. Ignored in
# production. Leave unset in Vercel.
KIT_LOCAL_PATH=Docs/Dashboard cockpit.zip
