# Auto-populated by the Vercel + Upstash integration once you create the
# Redis database in the Vercel dashboard — you shouldn't need to set these by
# hand in production. Copy this file to .env.local only if testing api/*.js
# locally with `vercel dev`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# You choose this value yourself and set it in Vercel project env vars.
# It gates GET /api/stats — anyone with this token can read your traffic
# counts, so treat it like a password.
STATS_TOKEN=

# --- Chat assistant (api/chat.js) ---
# From console.anthropic.com → API Keys. Server-side only: never give it a
# VITE_ prefix. Without it the chat widget shows its "can't answer right now" reply.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5; claude-sonnet-5-5 or claude-haiku-5-5 cost less.
CHAT_MODEL=
# Optional. Total chat messages accepted per calendar month (UTC) across all
# visitors. The default keeps a month at about $5 for the chosen model:
# 500 on Opus, 1000 on Sonnet, 20000 on Haiku. Also set a monthly spend limit
# in the Anthropic Console: that is the hard ceiling, this keeps the bot under it.
CHAT_MONTHLY_LIMIT=
# Optional. Total chat messages accepted per day across all visitors.
# Defaults to a tenth of the monthly limit.
CHAT_DAILY_LIMIT=

# --- Kit purchases (Razorpay): Delivery Cockpit and Claude skill for Job emails ---
# From Razorpay Dashboard → Account & Settings → API Keys. Use the rzp_test_...
# pair while testing and rzp_live_... in production. The key ID is public (the
# API hands it to the browser); the secret must never get a VITE_ prefix.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Price in major units (e.g. 49 or 999.50), shared by both products. Fixed server-side so a buyer can't
# change it. INR works for domestic and international cards; other currencies
# (USD, ...) need multi-currency enabled on your Razorpay account.
COCKPIT_PRICE=
COCKPIT_CURRENCY=INR

# LOCAL DEV ONLY: serve each kit zip straight from disk instead of Redis, so
# `npm run dev` can complete a test purchase with no Upstash setup. Ignored in
# production. Leave unset in Vercel.
KIT_LOCAL_PATH=Docs/Dashboard cockpit.zip
JOB_EMAIL_LOCAL_PATH=Docs/my-job-email.zip
