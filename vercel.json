{
  "functions": {
    "api/chat.js": {
      "includeFiles": "knowledge/**"
    }
  },
  "rewrites": [
    { "source": "/admin/chats", "destination": "/admin/chats.html" }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
